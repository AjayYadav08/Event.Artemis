# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional allowed CORS origins (e.g. Vercel preview URLs)
CORS_ORIGINS=""

# Database
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/event_artemis?schema=public"

# JWT Secrets (generate strong random 64-char hex strings for production)
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Provider ("local" for development, "s3" for production object storage)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# S3 / R2 / MinIO Object Storage (required when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# AI Extraction Provider ("none", "openai", or "gemini")
AI_PROVIDER="none"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
AI_MAX_INPUT_CHARS=12000

# Browser Automation & Crawling Limits
ENABLE_PLAYWRIGHT="false"
BROWSER_TIMEOUT_MS=20000
FETCH_TIMEOUT_MS=15000
MAX_PAGE_SIZE_BYTES=2097152
MAX_PDF_SIZE_BYTES=10485760
DEFAULT_MAX_CRAWL_DEPTH=2
DEFAULT_MAX_PAGES_PER_CYCLE=50
CRAWL_CONCURRENCY_PER_SOURCE=2
CRAWLER_USER_AGENT="EventArtemisBot/1.0 (+https://event-artemis.local)"

# Background Worker & Scheduler
ENABLE_IN_PROCESS_WORKER="true"
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=3000
SCHEDULER_POLL_INTERVAL_MS=30000
JOB_LOCK_TIMEOUT_MS=300000
DEFAULT_SYNC_INTERVAL_HOURS=12
SOON_DEADLINE_INTERVAL_HOURS=4
IMMINENT_EVENT_INTERVAL_HOURS=2
REDIS_URL=""


