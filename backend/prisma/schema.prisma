generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventCategory {
  Competition
  Fest
  Workshop
  Seminar
}

enum EventStatus {
  Live
  Upcoming
  Closed
  Past
}

enum ParticipationMode {
  Online
  Offline
  Hybrid
}

enum TeamMode {
  Team
  Solo
  Both
}

enum LocationType {
  OnCampus
  OffCampus
}

enum ExtractionStatus {
  MANUAL
  PENDING
  SYNCED
  FAILED
}

enum DataProvenance {
  MANUAL
  AUTOMATED
  HYBRID
}

enum RecruitmentStatus {
  Open
  Closed
}

enum TeamMemberRole {
  HOST
  ADMIN
  MEMBER
}

enum RequestStatus {
  Pending
  Accepted
  Rejected
}

enum MessageType {
  TEXT
  AUDIO
  ATTACHMENT
  SYSTEM
}

enum SourceType {
  SINGLE_EVENT
  COLLEGE_WEBSITE
  EVENT_LISTING
  OTHER
}

enum MonitoringStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum SyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  UPDATED
  NO_CHANGES
  NEEDS_REVIEW
  PARTIALLY_SUCCESSFUL
  FAILED
  PAUSED
}

enum ExtractionMethod {
  STRUCTURED_DATA
  STATIC_HTML
  DYNAMIC_BROWSER
  AI_EXTRACTION
  PDF_DOCUMENT
}

enum DiscoveredEventStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  MERGED_DUPLICATE
  NEEDS_REVIEW
}

enum FieldOwnership {
  AUTO
  MANUAL
  VERIFIED
  NEEDS_REVIEW
}

enum JobType {
  DISCOVER
  SYNC
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  profileImage String?
  role         UserRole @default(STUDENT)
  skills       String[] @default([])
  xp           Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  createdEvents      Event[]             @relation("EventCreator")
  eventInterests     EventInterest[]
  eventRegistrations EventRegistration[]
  createdTeams       Team[]              @relation("TeamCreator")
  teamMemberships    TeamMembership[]
  joinRequests       TeamJoinRequest[]
  sentInvitations    TeamInvitation[]    @relation("InvitationSender")
  receivedInvitations TeamInvitation[]   @relation("InvitationRecipient")
  chatMessages       ChatMessage[]
  messageDeletions   MessageDeletion[]
  uploadedAttachments ChatAttachment[]
  givenRatings       TeamRating[]        @relation("RatingGiver")
  receivedRatings    TeamRating[]        @relation("RatingReceiver")
  eventSources       EventSource[]       @relation("SourceCreator")
  reviewedDiscoveries DiscoveredEvent[]  @relation("DiscoveryReviewer")

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Event {
  id                  String            @id @default(uuid())
  title               String
  category            EventCategory
  type                EventStatus       @default(Upcoming)
  date                String
  dayOfMonth          Int
  time                String
  eventDate           DateTime
  registrationStart   DateTime?
  registrationDeadline DateTime?
  location            String
  campus              String?
  domain              String
  conductingAgency    String?
  locationType        LocationType      @default(OnCampus)
  participationMode   ParticipationMode @default(Offline)
  teamMode            TeamMode          @default(Both)
  registrationWindow  String?
  registrationUrl     String?
  xp                  Int               @default(0)
  attendees           Int               @default(0)
  sectionParticipants Int               @default(0)
  featured            Boolean           @default(false)
  description         String?
  jokes               Json              @default("[]")
  timeline            Json              @default("[]")
  venueDetails        String            @default("")
  prizePool           String?
  tracks              Json              @default("[]")
  posterUrl           String
  eligibility         String            @default("All Students")
  teamSize            String            @default("1-4 Members")
  certification       Boolean           @default(true)
  prizesList          Json              @default("[]")
  sponsors            Json              @default("[]")
  judges              Json              @default("[]")
  rules               Json              @default("[]")
  faqs                Json              @default("[]")
  organizerContact    Json?
  gallery             Json              @default("[]")
  isPaid              Boolean           @default(false)
  registrationFee     String            @default("Free")
  duration            String?
  rounds              Json              @default("[]")
  dos                 Json              @default("[]")
  donts               Json              @default("[]")

  // Future Automation Compatibility Fields (Phase 2 ready)
  sourceUrl            String?
  sourceType           String?
  externalSourceId     String?
  lastSyncedAt         DateTime?
  lastCheckedAt        DateTime?
  nextSyncAt           DateTime?
  extractionStatus     ExtractionStatus @default(MANUAL)
  dataProvenance       DataProvenance   @default(MANUAL)
  extractionConfidence Float?
  sourceMetadata       Json?

  createdById String?
  createdBy   User?    @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interests          EventInterest[]
  registrations      EventRegistration[]
  fieldHistory       EventFieldHistory[]
  sourcePages        EventSourcePage[]
  fieldSources       EventFieldSource[]
  syncHistory        EventSyncHistory[]
  fieldChangeHistory EventFieldChangeHistory[]
  approvedFrom       DiscoveredEvent[]   @relation("ApprovedEvent")
  duplicateMatches   DiscoveredEvent[]   @relation("DuplicateEvent")

  @@index([category])
  @@index([type])
  @@index([eventDate])
  @@index([registrationDeadline])
  @@index([domain])
  @@index([externalSourceId])
}

model EventFieldHistory {
  id            String         @id @default(uuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldName     String
  previousValue Json?
  newValue      Json?
  provenance    DataProvenance @default(MANUAL)
  confidence    Float?
  updatedById   String?
  createdAt     DateTime       @default(now())

  @@index([eventId, fieldName])
}

model EventInterest {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Team {
  id                String            @id @default(uuid())
  name              String
  hackathon         String
  description       String
  goals             String?
  expectations      String[]          @default([])
  maxMembers        Int               @default(4)
  recruitmentStatus RecruitmentStatus @default(Open)
  location          String?
  createdById       String
  createdBy         User              @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  memberships  TeamMembership[]
  joinRequests TeamJoinRequest[]
  invitations  TeamInvitation[]
  messages     ChatMessage[]
  attachments  ChatAttachment[]
  ratings      TeamRating[]

  @@index([recruitmentStatus])
  @@index([createdById])
}

model TeamMembership {
  id              String         @id @default(uuid())
  teamId          String
  userId          String
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            TeamMemberRole @default(MEMBER)
  memberRoleTitle String         @default("Contributor")
  skills          String[]       @default([])
  joinedAt        DateTime       @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamJoinRequest {
  id        String        @id @default(uuid())
  teamId    String
  userId    String
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    RequestStatus @default(Pending)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([teamId, status])
  @@index([userId, status])
}

model TeamInvitation {
  id          String        @id @default(uuid())
  teamId      String
  senderId    String
  recipientId String
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender      User          @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User          @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message     String?
  status      RequestStatus @default(Pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([recipientId, status])
  @@index([teamId, recipientId])
}

model TeamRating {
  id           String   @id @default(uuid())
  teamId       String
  raterId      String
  targetUserId String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rater        User     @relation("RatingGiver", fields: [raterId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("RatingReceiver", fields: [targetUserId], references: [id], onDelete: Cascade)
  stars        Int
  feedback     String?
  createdAt    DateTime @default(now())

  @@unique([teamId, raterId, targetUserId])
}

model ChatMessage {
  id                   String      @id @default(uuid())
  teamId               String
  senderId             String
  team                 Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender               User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content              String
  messageType          MessageType @default(TEXT)
  audioUrl             String?
  audioDuration        Int?
  deletedForEveryoneAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  deletions   MessageDeletion[]
  attachments ChatAttachment[]

  @@index([teamId, createdAt])
}

model MessageDeletion {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime    @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model ChatAttachment {
  id         String       @id @default(uuid())
  messageId  String?
  teamId     String?
  uploaderId String
  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  team       Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader   User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  fileSize   Int
  storageKey String
  fileUrl    String
  createdAt  DateTime     @default(now())

  @@index([messageId])
  @@index([teamId])
}

model EventSource {
  id                 String           @id @default(uuid())
  name               String
  sourceUrl          String
  sourceType         SourceType       @default(SINGLE_EVENT)
  description        String?
  monitoringEnabled  Boolean          @default(true)
  monitoringStatus   MonitoringStatus @default(ACTIVE)
  syncIntervalHours  Int              @default(12)
  maxCrawlDepth      Int              @default(2)
  maxPagesPerCycle   Int              @default(50)
  extractionOptions  Json             @default("{}")
  lastCheckedAt      DateTime?
  lastSuccessfulAt   DateTime?
  nextCheckAt        DateTime?
  lastSyncStatus     SyncStatus       @default(PENDING)
  lastError          String?
  etag               String?
  lastModified       String?
  contentHash        String?
  aiRequestsUsed     Int              @default(0)
  createdById        String?
  createdBy          User?            @relation("SourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  pages              EventSourcePage[]
  discoveredEvents   DiscoveredEvent[]
  syncHistory        EventSyncHistory[]
  jobs               SyncJob[]
  notifications      AdminNotification[]

  @@index([monitoringEnabled, nextCheckAt])
  @@index([sourceUrl])
}

model EventSourcePage {
  id               String           @id @default(uuid())
  sourceId         String
  source           EventSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  pageUrl          String
  pageType         String           @default("DETAIL")
  externalEventId  String?
  contentHash      String?
  etag             String?
  lastModified     String?
  lastCheckedAt    DateTime?
  lastSuccessfulAt DateTime?
  nextCheckAt      DateTime?
  extractionMethod ExtractionMethod?
  extractionStatus SyncStatus       @default(PENDING)
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  discoveredEvents   DiscoveredEvent[]
  fieldSources       EventFieldSource[]
  fieldChangeHistory EventFieldChangeHistory[]

  @@unique([sourceId, pageUrl])
  @@index([eventId])
  @@index([nextCheckAt])
}

model DiscoveredEvent {
  id                   String                @id @default(uuid())
  sourceId             String
  source               EventSource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourcePageId         String?
  sourcePage           EventSourcePage?      @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  approvedEventId      String?
  approvedEvent        Event?                @relation("ApprovedEvent", fields: [approvedEventId], references: [id], onDelete: SetNull)
  duplicateOfEventId   String?
  duplicateOfEvent     Event?                @relation("DuplicateEvent", fields: [duplicateOfEventId], references: [id], onDelete: SetNull)
  duplicateConfidence  Float?
  duplicateSignals     Json                  @default("[]")
  status               DiscoveredEventStatus @default(PENDING_REVIEW)
  extractionMethod     ExtractionMethod      @default(STATIC_HTML)
  confidence           Float                 @default(0.5)
  title                String
  sourcePageUrl        String
  normalizedPayload    Json
  rawExtracted         Json                  @default("{}")
  fieldProvenance      Json                  @default("{}")
  extractedFields      String[]              @default([])
  missingFields        String[]              @default([])
  validationWarnings   String[]              @default([])
  reviewedById         String?
  reviewedBy           User?                 @relation("DiscoveryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([sourceId, status])
  @@index([status])
  @@index([sourcePageUrl])
}

model EventFieldSource {
  id                   String           @id @default(uuid())
  eventId              String
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldName            String
  sourcePageId         String?
  sourcePage           EventSourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  extractedValue       Json?
  rawValue             String?
  confidence           Float            @default(0.8)
  ownership            FieldOwnership   @default(AUTO)
  isManuallyOverridden Boolean          @default(false)
  verifiedAt           DateTime?
  updatedAt            DateTime         @updatedAt

  @@unique([eventId, fieldName])
  @@index([sourcePageId])
}

model EventSyncHistory {
  id               String      @id @default(uuid())
  sourceId         String
  source           EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  status           SyncStatus  @default(PROCESSING)
  pagesScanned     Int         @default(0)
  eventsDiscovered Int         @default(0)
  eventsUpdated    Int         @default(0)
  fieldsUpdated    Int         @default(0)
  aiCallsUsed      Int         @default(0)
  errorMessage     String?
  summary          Json        @default("{}")

  @@index([sourceId, startedAt])
  @@index([eventId])
}

model EventFieldChangeHistory {
  id             String           @id @default(uuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldName      String
  previousValue  Json?
  newValue       Json?
  sourcePageId   String?
  sourcePage     EventSourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  confidence     Float?
  applied        Boolean          @default(true)
  requiresReview Boolean          @default(false)
  reviewedById   String?
  changedAt      DateTime         @default(now())

  @@index([eventId, changedAt])
}

model SyncJob {
  id              String      @id @default(uuid())
  sourceId        String
  source          EventSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jobType         JobType     @default(SYNC)
  status          JobStatus   @default(QUEUED)
  priority        Int         @default(0)
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3)
  runAt           DateTime    @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  startedAt       DateTime?
  completedAt     DateTime?
  progress        Int         @default(0)
  progressMessage String?
  result          Json?
  error           String?
  triggeredById   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, runAt])
  @@index([sourceId, status])
}

model AdminNotification {
  id            String       @id @default(uuid())
  sourceId      String?
  source        EventSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  eventId       String?
  type          String
  title         String
  message       String
  metadata      Json         @default("{}")
  readByUserIds String[]     @default([])
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

